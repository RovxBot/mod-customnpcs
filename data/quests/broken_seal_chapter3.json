      },
      "source_item": null,
      "source_count": 0,
      "reward_choices": [],
      "fixed_rewards": {},
      "xp_difficulty": 5,
      "money": 1280,
      "objectives": "Collect 12 quest lotus leaves and help Kang prepare a second treatment.",
      "description": "The antidote eased the fever, but Leza is still weak. Collect twelve quest lotus leaves among the southern marsh paths. Ask Kang to prepare the treatment when you have them, then return the leaves to me. These are camp supplies, not a test of your herbalism.",
      "completion": "Kang has prepared what he can from these leaves. We have bought time, not certainty.",
      "exclusive_group": -900307
    },
    {
      "key": "QUEST_AGENDA",
      "id": 900306,
      "design_id": "BS-C03-07",
      "title": "The Relic Raiders Agenda",
      "level": 32,
      "min_level": 30,
      "giver": "NPC_DEZCO",
      "turn_in": "NPC_DEZCO",
      "previous": "QUEST_STEW",
      "prerequisites": [
