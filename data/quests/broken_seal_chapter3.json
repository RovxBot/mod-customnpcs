  "quests": [
    {
      "key": "QUEST_SEARCH",
      "id": 900300,
      "design_id": "BS-C03-01",
      "title": "Search Party",
      "level": 30,
      "min_level": 30,
      "giver": "NPC_DEZCO",
      "turn_in": "NPC_DEZCO",
      "previous": "QUEST_C02_END",
      "prerequisites": [
        "QUEST_C02_END"
      ],
      "credits": {},
      "required_items": {
        "ITEM_ORDERS": 1
      },
      "source_item": null,
      "source_count": 0,
      "reward_choices": [],
      "fixed_rewards": {},
      "xp_difficulty": 4,
      "money": 1200,
      "objectives": "Find Chezin at the ruined scouting camp and recover his report.",
      "description": "Jarod trusts you, and that is enough for me. My brother-in-law Chezin went to the scouting camp southeast of us. The camp has fallen silent. Follow the marker and find him. If he has a report, bring it back. Do not promise Leza he is coming home until you know.",
      "completion": "Chezin is gone. I will tell Leza myself. These orders give us something we can still act on."
    },
    {
      "key": "QUEST_POISON",
      "id": 900301,
      "design_id": "BS-C03-02",
      "title": "Poisoned!",
      "level": 30,
      "min_level": 30,
      "giver": "NPC_DEZCO",
      "turn_in": "NPC_DEZCO",
      "previous": "QUEST_SEARCH",
      "prerequisites": [
        "QUEST_SEARCH"
      ],
      "credits": {
        "CREDIT_TREATED": 1
      },
      "required_items": {},
      "source_item": "ITEM_ANTIDOTE",
      "source_count": 1,
      "reward_choices": [],
      "fixed_rewards": {},
      "xp_difficulty": 4,
      "money": 1200,
      "objectives": "Obtain the supplied antidote and administer it to Leza while Nala monitors her.",
      "description": "Leza is ill, and the marsh fever has brought her into labor too soon. Kang has prepared an antidote. Ask Nala to prepare Leza inside the medical tent, then target your private patient with the antidote while Nala is beside her. Stay for her response. We need to know whether it helps.",
      "completion": "The fever has eased, but this is not a cure. We will keep looking, and Nala will stay with her."
    },
    {
      "key": "QUEST_STEW",
      "id": 900302,
      "design_id": "BS-C03-03",
      "title": "Skitterer Stew",
      "level": 30,
      "min_level": 30,
      "giver": "NPC_KANG",
      "turn_in": "NPC_KANG",
      "previous": "QUEST_POISON",
      "prerequisites": [
        "QUEST_POISON"
      ],
      "credits": {
        "CREDIT_STEW": 1
      },
      "required_items": {
        "ITEM_MEAT": 8
      },
      "source_item": null,
      "source_count": 0,
      "reward_choices": [],
      "fixed_rewards": {},
      "xp_difficulty": 5,
      "money": 1200,
      "objectives": "Gather 8 skitterer meat and help prepare food for the weakened camp.",
      "description": "People who have not eaten cannot recover. Gather eight pieces of meat from the marsh skitterers south of camp, then use our cooking hearth to help prepare the stew. Keep the ingredients until you return them to me. Nobody here needs a cooking profession to lend a hand.",
      "completion": "Hot food will do more for this camp than another empty assurance. Thank you.",
      "exclusive_group": -900304
    },
    {
      "key": "QUEST_BLIND",
      "id": 900303,
      "design_id": "BS-C03-04",
      "title": "Blind Them!",
      "level": 31,
      "min_level": 30,
      "giver": "NPC_KOR",
      "turn_in": "NPC_KOR",
      "previous": "QUEST_POISON",
      "prerequisites": [
        "QUEST_POISON"
      ],
      "credits": {
        "NPC_RAIDER": 6,
        "CREDIT_LOOKOUT_A": 1,
        "CREDIT_LOOKOUT_B": 1,
        "CREDIT_LOOKOUT_C": 1
      },
      "required_items": {},
      "source_item": null,
      "source_count": 0,
      "reward_choices": [],
      "fixed_rewards": {},
      "xp_difficulty": 5,
      "money": 1240,
      "objectives": "Disable 3 raider lookout posts and defeat 6 guards watching the expedition.",
      "description": "The relic raiders are watching us. Disable each of the three marked lookout posts to the southeast and defeat six Marsh Relic Raiders. Each post needs only one visit; striking the same marker again will not blind another lookout. Keep their attention away from the medical tent.",
      "completion": "Their lookout line is broken. Now we can prepare without their eyes on every movement.",
      "exclusive_group": -900304
    },
    {
      "key": "QUEST_THREAT",
      "id": 900304,
      "design_id": "BS-C03-05",
      "title": "Threat from the Marsh Ruins",
      "level": 31,
      "min_level": 30,
      "giver": "NPC_KOR",
      "turn_in": "NPC_KOR",
      "previous": "QUEST_STEW",
      "prerequisites": [
        "QUEST_STEW",
        "QUEST_BLIND"
      ],
      "credits": {},
      "required_items": {
        "ITEM_INSIGNIA": 8
      },
      "source_item": null,
      "source_count": 0,
      "reward_choices": [],
      "fixed_rewards": {},
      "xp_difficulty": 5,
      "money": 1240,
      "objectives": "Defeat 8 relic raiders before their next camp attack.",
      "description": "The watchers were only the edge of the force. Defeat relic raiders and hexers at their dig, and bring back eight insignia as proof that their next attack has been broken. This expedition has families in it, and I mean to keep them alive.",
      "completion": "They will have to regroup before they try us again. I will keep the watch.",
      "exclusive_group": -900307
    },
    {
      "key": "QUEST_HERBS",
      "id": 900305,
      "design_id": "BS-C03-06",
      "title": "Herbal Remedies",
      "level": 32,
      "min_level": 30,
      "giver": "NPC_DEZCO",
      "turn_in": "NPC_DEZCO",
      "previous": "QUEST_STEW",
      "prerequisites": [
        "QUEST_STEW",
