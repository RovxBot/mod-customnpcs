      "source_item": null,
      "source_count": 0,
      "reward_choices": [],
      "fixed_rewards": {},
      "xp_difficulty": 5,
      "money": 1320,
      "objectives": "Stand by Dezco while Nala tends Leza; witness the birth, Leza's death and the two surviving sons.",
      "description": "Kang has found the same draining mark in the water and in the stones the raiders unearthed. Leza has already been exposed. Nala cannot leave her now. Use the medical tent and stand nearby while we attend to her. Stay with us through the birth and what follows. Your presence is all I can ask.",
      "completion": "Leza is gone. Redhorn and Cloudhoof are here. I must be here for them, too."
    },
    {
      "key": "QUEST_VIGIL",
      "id": 900309,
      "design_id": "BS-C03-10",
      "title": "A Quiet Vigil",
      "level": 34,
      "min_level": 30,
      "giver": "NPC_DEZCO",
