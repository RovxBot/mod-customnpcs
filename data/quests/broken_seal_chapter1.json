  "quests": [
    {
      "key": "QUEST_COMMISSION_A",
      "id": 900100,
      "logical_id": "BS-C01-01",
      "title": "An Unusual Commission",
      "level": 20,
      "min_level": 20,
      "faction": "Alliance",
      "description": "The expedition in Stonetalon is accepting help from anyone willing to put missing travelers before old quarrels. Take this invitation to Maruut Stonebinder. His camp is on the eastern approach to the Charred Vale.",
      "objectives": "Follow the old road toward the Charred Vale and look for the expedition's blue-clad stonebinder.",
      "completion": "You came. Good. Three of our people are overdue, and the trail is beginning to give answers I do not like.",
      "xp_difficulty": 2,
      "money": 300,
      "giver": "NPC_COURIER_A",
      "turn_in": "NPC_MARUUT",
      "source_item": "ITEM_INVITATION",
      "required_items": {
        "ITEM_INVITATION": 1
      },
      "previous": null,
      "exclusive_group": 900100
    },
    {
      "key": "QUEST_COMMISSION_H",
      "id": 900101,
      "logical_id": "BS-C01-02",
      "title": "An Unusual Commission",
      "level": 20,
      "min_level": 20,
      "faction": "Horde",
      "description": "Maruut Stonebinder needs help in Stonetalon. Three surveyors have vanished near the Charred Vale. This is an expedition, not a border dispute. Take this invitation to his neutral camp on the valley's eastern approach.",
      "objectives": "Look for the expedition camp above the Charred Vale. Maruut will recognize the invitation.",
      "completion": "You came. Good. Three of our people are overdue, and the trail is beginning to give answers I do not like.",
      "xp_difficulty": 2,
      "money": 300,
      "giver": "NPC_COURIER_H",
