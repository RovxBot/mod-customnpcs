#
# mod-customNPCs Configuration
#

[worldserver]

########################################
# mod-customNPCs
########################################
#
#    ModCustomNPCs.Enable
#        Description: Enable or disable the custom NPCs module.
#        Default:     1 (Enabled)
#                     0 (Disabled)
#

ModCustomNPCs.Enable = 1

#
#    ModCustomNPCs.Announce
#        Description: Announce module on player login.
#        Default:     1 (Enabled)
#                     0 (Disabled)
#

ModCustomNPCs.Announce = 1

#
#    ModCustomNPCs.Nubmage.PortalPriceGold
#        Description: Price in gold for each Nubmage portal.
#                     Applied by the C++ gossip handler.
#        Default:     10
#

ModCustomNPCs.Nubmage.PortalPriceGold = 10

#
#    ModCustomNPCs.Appearance.Enable
#        Description: Render assigned NPC outfits using player race, gender,
#                     customization, armor, and weapons. No client patch required
#                     for native WotLK assets. Changing this option with .reload
#                     config restores or reapplies outfits on the next NPC update.
#                     Also requires ModCustomNPCs.Enable = 1.
#        Default:     1
#

ModCustomNPCs.Appearance.Enable = 1

#
#    ModCustomNPCs.BrokenSeal.Chapter1.Enable
#        Description: Enable Chapter 1 quest interactions, private escorts,
#                     tracing and observation scenes. Requires the Chapter 1 SQL
#                     and ModCustomNPCs.Enable = 1. Config reloads update the
#                     expedition contacts within two seconds.
#        Default:     1
#

ModCustomNPCs.BrokenSeal.Chapter1.Enable = 1

# Chapter 2 requires Chapter 1, its world SQL, and native NPC appearances.
# Enables the cult training trials and Jarod rescue in the Charred Vale.
ModCustomNPCs.BrokenSeal.Chapter2.Enable = 1

# Chapter 3 requires Chapters 1/2 and its world SQL.
# Enables the Dawnchaser medical story and marsh expedition in Dustwallow.
ModCustomNPCs.BrokenSeal.Chapter3.Enable = 1

# Shared camp sentries and localized ambient-NPC protection. Requires broken_seal_hubs.sql.
# Scripted encounters, bosses, player pets and PvP retain their normal behavior.
ModCustomNPCs.BrokenSeal.Hubs.Enable = 1
